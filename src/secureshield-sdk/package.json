{
  "name": "@secureshield/web",
  "version": "4.2.0",
  "description": "SecureShield Detection Engine SDK for Web & WebAssembly",
  "main": "./secureshield.js",
  "module": "./secureshield.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./secureshield.js",
      "default": "./secureshield.js"
    },
    "./wasm": {
      "types": "./secureshield.wasm.d.ts",
      "import": "./secureshield.wasm.js",
      "default": "./secureshield.wasm.js"
    }
  }
}